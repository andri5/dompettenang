# Maintenance mode (sama konsep VITE_MAINTENANCE_MODE di web)
# EXPO_PUBLIC_MAINTENANCE_MODE=true

# Default: production (bisa dipakai dari Wi‑Fi / 4G mana saja)
EXPO_PUBLIC_API_URL=https://dompet-tenang.web.id/api/v1
EXPO_PUBLIC_WEB_URL=https://dompet-tenang.web.id

# Dev lokal — HP & PC harus satu Wi‑Fi; ganti IP LAN laptop:
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3001/api/v1

# Emulator Android → host machine
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api/v1

# iOS Simulator
# EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1

# EAS APK internal (LAN): eas.json → build.release.env.EXPO_PUBLIC_API_URL
# EAS APK + Play Store (prod): eas.json → release-prod-api / production
