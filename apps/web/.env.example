# Prefer same-origin API (Vite proxies /api/v1 → :3001) for HttpOnly cookies
VITE_API_URL=/api/v1

# Public site URL (SEO canonical / Open Graph). Production contoh:
# VITE_SITE_URL=https://dompet-tenang.web.id
VITE_SITE_URL=http://127.0.0.1:5173

# Optional absolute origin (breaks cookie SameSite on localhost unless carefully configured)
# VITE_API_ORIGIN=http://localhost:3001

# Set to true to show maintenance page for the entire web app
# VITE_MAINTENANCE_MODE=true

# Turnstile site key comes from API GET /auth/captcha-config (set TURNSTILE_* on API).
# Toggle via Admin → Feature Flags → captcha_auth
