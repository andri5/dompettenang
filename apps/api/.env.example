# Environment Configuration for Dompet Tenang API

# Server
NODE_ENV=development
PORT=3001

# Database - PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/dompettenang?schema=public"

# JWT Secrets (REQUIRED in production)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# Cors / Frontend
CORS_ORIGIN="http://localhost:5173"
APP_URL="http://localhost:5173"

# Cookies (web HttpOnly). Mobile uses Bearer tokens from JSON body.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# SMTP — Gmail example (use App Password, not account password)
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=
SMTP_FROM="Dompet Tenang <your-email@gmail.com>"

# Dev only: include resetUrl in JSON when SMTP is off (ignored in production)
EXPOSE_PASSWORD_RESET_URL=false

# Cloudflare Turnstile (optional). Enable via Admin → Feature Flags → captcha_auth
# Local always-pass test keys: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Pro Lifetime — manual bank transfer (harga early bird Rp 29.000)
PRO_LIFETIME_PRICE=29000
PRO_BANK_NAME=BCA
PRO_BANK_ACCOUNT=1234567890
PRO_BANK_HOLDER=Nama Pemilik Rekening
