# Copy to deploy/.env.staging on the VPS (never commit real secrets).
# Staging shares the VPS with production but uses its own DB + JWT.

# --- Domain (apex; staging URL becomes https://staging.DOMAIN) ---
DOMAIN=dompet-tenang.web.id
CORS_ORIGIN=https://staging.dompet-tenang.web.id
APP_URL=https://staging.dompet-tenang.web.id

# --- Postgres (staging-only) ---
POSTGRES_USER=dompet_stg
POSTGRES_PASSWORD=ganti-password-db-staging-yang-kuat
POSTGRES_DB=dompettenang_staging

# --- JWT (wajib beda dari production) ---
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- SMTP (boleh sama Sumopod seperti production) ---
SMTP_ENABLED=true
SMTP_HOST=smtp.sumopod.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Dompet Tenang Staging <noreply@dompet-tenang.web.id>"

# --- Turnstile (opsional; boleh key test) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Pro (boleh rekening test / sama production) ---
PRO_LIFETIME_PRICE=29000
PRO_BANK_NAME=
PRO_BANK_ACCOUNT=
PRO_BANK_HOLDER=

COOKIE_SAME_SITE=lax
