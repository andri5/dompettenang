# Copy to deploy/.env.production and fill in real values.
# NEVER commit deploy/.env.production

# --- Domain (tanpa https://) ---
DOMAIN=dompet-tenang.web.id

# --- Postgres ---
POSTGRES_USER=dompet
POSTGRES_PASSWORD=ganti-password-db-yang-kuat
POSTGRES_DB=dompettenang

# --- JWT (wajib unik & panjang; generate: openssl rand -base64 48) ---
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- App URLs (same-origin lewat Caddy) ---
CORS_ORIGIN=https://dompet-tenang.web.id
APP_URL=https://dompet-tenang.web.id
COOKIE_SAME_SITE=lax

# --- SMTP (reset password) ---
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=email-anda@gmail.com
SMTP_PASS=app-password-gmail
SMTP_FROM="Dompet Tenang <email-anda@gmail.com>"

# --- Cloudflare Turnstile (production keys, bukan 1x0000...) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Android download (web build-time) ---
# APK file is served by Caddy from deploy/downloads/dompet-tenang.apk
VITE_ANDROID_APK_URL=/download/dompet-tenang.apk
# Expo internal builds (tester)
VITE_EXPO_BUILDS_URL=https://expo.dev/accounts/andri5/projects/duitdiary/builds
