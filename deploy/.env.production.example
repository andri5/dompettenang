# Copy to deploy/.env.production and fill in real values.
# NEVER commit deploy/.env.production

# --- Domain (tanpa https://) ---
DOMAIN=dompet-tenang.web.id

# --- Postgres ---
POSTGRES_USER=dompet
POSTGRES_PASSWORD=ganti-password-db-yang-kuat
POSTGRES_DB=dompettenang

# --- JWT (wajib unik & panjang; generate: openssl rand -base64 48) ---
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- App URLs (same-origin lewat Caddy) ---
CORS_ORIGIN=https://dompet-tenang.web.id
APP_URL=https://dompet-tenang.web.id
COOKIE_SAME_SITE=lax

# --- SMTP (reset password) — Sumopod Email SMTP ---
# Dashboard Sumopod → Email SMTP → Credentials → Create Credential
# Docs: https://docs.sumopod.com/guides/smtp/create-smtp
SMTP_ENABLED=true
SMTP_HOST=smtp.sumopod.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=username-dari-sumopod
SMTP_PASS=password-dari-sumopod
# Default Sumopod / custom domain yang sudah diverifikasi di tab Custom Domain
SMTP_FROM="Dompet Tenang <noreply@domain-anda.com>"

# --- Cloudflare Turnstile (production keys, bukan 1x0000...) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Pro Lifetime (manual transfer bank) ---
# Isi rekening asli di VPS (deploy/.env.production). Tanpa ini, form upgrade menolak create.
PRO_LIFETIME_PRICE=29000
PRO_BANK_NAME=
PRO_BANK_ACCOUNT=
PRO_BANK_HOLDER=
